From 89fddcc74e7282873b08da83904cc7ef9d3fd786 Mon Sep 17 00:00:00 2001
From: Indra Kumar <IndraKumar.Siliveru@amd.com>
Date: Wed, 25 Feb 2026 08:18:10 -0800
Subject: [PATCH 1/2] PKTGEN-24.10.3-Patch-to-add-Jumbo-packet-support

Signed-off-by: Bharat Kumar Gogada <bharat.kumar.gogada@amd.com>
Signed-off-by: Indra Kumar <IndraKumar.Siliveru@amd.com>
---
 app/lpktgenlib.c       |  3 +++
 app/meson.build        |  1 +
 app/pktgen-cmds.c      | 15 ++++++++++-----
 app/pktgen-constants.h |  3 ++-
 app/pktgen-latency.c   |  2 ++
 app/pktgen-main.c      | 26 ++++++++++++++++----------
 app/pktgen-port-cfg.c  |  2 ++
 app/pktgen-range.c     |  3 ++-
 app/pktgen-stats.c     |  3 +++
 app/pktgen.c           |  5 +++++
 app/pktgen.h           |  3 +++
 11 files changed, 49 insertions(+), 17 deletions(-)

diff --git a/app/lpktgenlib.c b/app/lpktgenlib.c
index f81454b..3975107 100644
--- a/app/lpktgenlib.c
+++ b/app/lpktgenlib.c
@@ -14,6 +14,9 @@
 #include <pg_inet.h>
 #include "lpktgenlib.h"

+#include <bus_driver.h>
+#include <bus_pci_driver.h>
+
 #include <stdint.h>
 #include <netinet/in.h>

diff --git a/app/meson.build b/app/meson.build
index efeab9d..2c23d19 100644
--- a/app/meson.build
+++ b/app/meson.build
@@ -44,6 +44,7 @@ deps += [cc.find_library('rte_net_i40e', dirs: [dpdk_libs_path], required: false
 deps += [cc.find_library('rte_net_ixgbe', dirs: [dpdk_libs_path], required: false)]
 deps += [cc.find_library('rte_net_ice', dirs: [dpdk_libs_path], required: false)]
 deps += [cc.find_library('rte_bus_vdev', dirs: [dpdk_libs_path], required: false)]
+deps += [cc.find_library('rte_net_qdma', required: true)]

 deps += [dependency('threads')]
 deps += [dependency('numa', required: true)]
diff --git a/app/pktgen-cmds.c b/app/pktgen-cmds.c
index 4b94232..8c9503e 100644
--- a/app/pktgen-cmds.c
+++ b/app/pktgen-cmds.c
@@ -2702,10 +2702,14 @@ debug_set_tx_cycles(port_info_t *pinfo, uint32_t cycles)
 void
 single_set_pkt_size(port_info_t *pinfo, uint16_t size)
 {
+	uint16_t pktsize = (pktgen.flags & MTU9K_SUPPORT_FLAG) ?
+		MAX_PKT_SIZE : (RTE_ETHER_MAX_LEN - RTE_ETHER_CRC_LEN);
     pkt_seq_t *pkt = &pinfo->seq_pkt[SINGLE_PKT];

     if (size < RTE_ETHER_MIN_LEN)
         size = RTE_ETHER_MIN_LEN;
+    if ((pktgen.flags & MTU9K_SUPPORT_FLAG) && (size - RTE_ETHER_CRC_LEN) > pktsize)
+	    size = pktsize + RTE_ETHER_CRC_LEN;

     if ((pktgen.flags & JUMBO_PKTS_FLAG) && size > RTE_ETHER_MAX_JUMBO_FRAME_LEN)
         size = RTE_ETHER_MAX_JUMBO_FRAME_LEN;
@@ -2715,8 +2719,7 @@ single_set_pkt_size(port_info_t *pinfo, uint16_t size)
     if ((pkt->ethType == RTE_ETHER_TYPE_IPV6) && (size < MIN_v6_PKT_SIZE))
         size = MIN_v6_PKT_SIZE;

-    pkt->pkt_size = (size - RTE_ETHER_CRC_LEN);
-
+    pkt->pkt_size = size;
     pktgen_packet_ctor(pinfo, SINGLE_PKT, -1);
     pktgen_packet_rate(pinfo);
 }
@@ -3630,6 +3633,8 @@ range_set_cos_id(port_info_t *pinfo, char *what, uint8_t id)
 void
 range_set_pkt_size(port_info_t *pinfo, char *what, uint16_t size)
 {
+   uint32_t pktsize = (pktgen.flags & MTU9K_SUPPORT_FLAG) ?
+	   MAX_9K_SIZE : RTE_ETHER_MAX_LEN;
     if (!strcmp(what, "inc") || !strcmp(what, "increment")) {
         if ((pktgen.flags & JUMBO_PKTS_FLAG) && (size > RTE_ETHER_MAX_JUMBO_FRAME_LEN))
             size = RTE_ETHER_MAX_JUMBO_FRAME_LEN;
@@ -3638,10 +3643,10 @@ range_set_pkt_size(port_info_t *pinfo, char *what, uint16_t size)
         if (size < RTE_ETHER_MIN_LEN)
             size = RTE_ETHER_MIN_LEN;

-        if ((pktgen.flags & JUMBO_PKTS_FLAG) && (size > RTE_ETHER_MAX_JUMBO_FRAME_LEN))
+	if ((pktgen.flags & JUMBO_PKTS_FLAG) && (size > RTE_ETHER_MAX_JUMBO_FRAME_LEN))
             size = RTE_ETHER_MAX_JUMBO_FRAME_LEN;
-        else if (size > RTE_ETHER_MAX_LEN)
-            size = RTE_ETHER_MAX_LEN;
+	 else if (size > pktsize)
+	       size = pktsize;

         if (pinfo->seq_pkt[RANGE_PKT].ethType == RTE_ETHER_TYPE_IPV6 && size < MIN_v6_PKT_SIZE)
             size = MIN_v6_PKT_SIZE;
diff --git a/app/pktgen-constants.h b/app/pktgen-constants.h
index bc803df..c49d45b 100644
--- a/app/pktgen-constants.h
+++ b/app/pktgen-constants.h
@@ -19,12 +19,13 @@ enum {
     MAX_PKT_TX_BURST                  = 128, /* Used to create Max array sizes */
     DEFAULT_PKT_RX_BURST              = 64,  /* Increasing this number consumes memory very fast */
     DEFAULT_PKT_TX_BURST              = 32,  /* Increasing this number consumes memory very fast */
-    DEFAULT_RX_DESC                   = (MAX_PKT_RX_BURST * 8),
+    DEFAULT_RX_DESC     	      =	(MAX_PKT_RX_BURST * 8 * 2),
     DEFAULT_TX_DESC                   = (MAX_PKT_TX_BURST * 16),
     DEFAULT_MBUFS_PER_PORT_MULTIPLIER = 8, /* Multiplier for number of mbufs per port */
     MAX_SPECIAL_MBUFS                 = 1024,
     MBUF_CACHE_SIZE                   = 128,
     DEFAULT_PRIV_SIZE                 = 0,
+    MBUF_9K_SIZE            	      =	9018 + RTE_PKTMBUF_HEADROOM + DEFAULT_PRIV_SIZE,
 };

 #define MAX_MBUFS_PER_PORT(rxd, txd) ((rxd + txd) * DEFAULT_MBUFS_PER_PORT_MULTIPLIER)
diff --git a/app/pktgen-latency.c b/app/pktgen-latency.c
index 1a1b4a5..be1f2c2 100644
--- a/app/pktgen-latency.c
+++ b/app/pktgen-latency.c
@@ -8,6 +8,8 @@

 #include <stdio.h>

+#include <bus_driver.h>
