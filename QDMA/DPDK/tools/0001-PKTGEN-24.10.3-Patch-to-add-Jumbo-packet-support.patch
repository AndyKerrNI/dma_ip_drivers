diff --git a/app/pktgen.c b/app/pktgen.c
index 9c7abcd..f5595db 100644
--- a/app/pktgen.c
+++ b/app/pktgen.c
@@ -115,6 +115,7 @@ pktgen_wire_size(port_info_t *pinfo)
         } else
             size = WIRE_SIZE(pinfo->seq_pkt[SINGLE_PKT].pkt_size, uint64_t);
     }
+    size -= (PKT_PREAMBLE_SIZE + INTER_FRAME_GAP + RTE_ETHER_CRC_LEN);
     return (size * 8);
 }

@@ -1082,6 +1083,9 @@ pktgen_main_receive(port_info_t *pinfo, uint16_t qid, struct rte_mbuf **pkts_bur
         for (int i = 0; i < nb_rx; i++)
             qstats->q_ibytes[qid] += rte_pktmbuf_pkt_len(pkts_burst[i]);

+	pinfo->pkt_sizes._64 += nb_rx;
+	rte_pktmbuf_free_bulk(pkts_burst, nb_rx);
+#if 0
         pktgen_tstamp_check(pinfo, pkts_burst, nb_rx);

         /* classify the packets for the counters */
@@ -1098,6 +1102,7 @@ pktgen_main_receive(port_info_t *pinfo, uint16_t qid, struct rte_mbuf **pkts_bur
         }

         rte_pktmbuf_free_bulk(pkts_burst, nb_rx);
+#endif
     }
 }

diff --git a/app/pktgen.h b/app/pktgen.h
index 4384911..4d92f4d 100644
--- a/app/pktgen.h
+++ b/app/pktgen.h
@@ -239,6 +239,8 @@ enum {
     PCAP_PAGE_SIZE = 25  /**< Size of the PCAP display page */
 };

+#define MAX_9K_SIZE    9018
+#define MAX_PKT_SIZE   (MAX_9K_SIZE - RTE_ETHER_CRC_LEN)
 #define WIRE_SIZE(pkt_size, t) (t)(pkt_size + PKT_OVERHEAD_SIZE)

 typedef struct rte_mbuf rte_mbuf_t;
@@ -306,6 +308,7 @@ enum {                                    /* Pktgen flags bits */
        RESERVED_9             = (1 << 9),
        BLINK_PORTS_FLAG       = (1 << 10), /**< Blink the port leds */
        ENABLE_THEME_FLAG      = (1 << 11), /**< Enable theme or color support */
+       MTU9K_SUPPORT_FLAG     = (1 << 15),    /**< MTU 9K support */
        CLOCK_GETTIME_FLAG     = (1 << 12), /**< Enable clock_gettime() instead of rdtsc() */
        JUMBO_PKTS_FLAG        = (1 << 13), /**< Enable Jumbo frames */
        RESERVED_14            = (1 << 14),
