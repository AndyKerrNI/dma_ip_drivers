+    range->pkt_size_max = (pktgen.flags & MTU9K_SUPPORT_FLAG) ?
+	MAX_PKT_SIZE : (RTE_ETHER_MAX_LEN - RTE_ETHER_CRC_LEN);

     range->vxlan_gid     = pinfo->seq_pkt[SINGLE_PKT].group_id;
     range->vxlan_gid_inc = 0;
